# Copy to backend/.env for running the API/worker outside Docker.
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+psycopg://rag_app:rag_app@localhost:5433/rag      # app role: row-level security applies
MIGRATION_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag     # owner: migrations only
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=52428800

# Models. Local by default: BAAI/bge-m3 embeddings and a cross-encoder reranker, served by the
# `models` container (MODEL_SERVER_URL). "voyage" uses the hosted API instead (needs a key).
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_PROVIDER=local
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # or BAAI/bge-reranker-v2-m3 with more RAM
# MODEL_SERVER_URL=http://localhost:8001   # only when running outside Docker against `models`
# LOCAL_MODEL_DTYPE=float32                # float16 halves memory
VOYAGE_API_KEY=

# Reranking and context
RERANK_CANDIDATES=30
RERANK_TOP_K=8
# RERANK_MIN_SCORE=0.1                     # pick from the eval report's threshold table
CONTEXT_TOKEN_BUDGET=3000

# Chunking
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_RATIO=0.15
CHUNK_CONTEXTUAL_HEADER=true

# Answers with Claude (Phase 5)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium          # low | medium | high | xhigh | max
LLM_MAX_TOKENS=16000
LLM_FALLBACKS=true         # re-run refused requests on Anthropic's recommended fallback model

# Authentication and security (Phase 6)
JWT_SECRET=change-me-to-32+-random-characters   # e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
ALLOW_REGISTRATION=true
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=60

# Conversations (Phase 7)
LLM_HELPER_MODEL=claude-haiku-5-5   # rewrites follow-up questions, summarises older turns
CHAT_HISTORY_MESSAGES=6             # recent messages Claude sees verbatim
CHAT_HISTORY_MAX_CHARS=2000         # per message
CHAT_SUMMARY_AFTER_MESSAGES=10      # summarise older turns beyond this many unsummarised
